<Project>

	<!-- Documentation generation is opt-in via IsPackable. Projects that ship as NuGet packages set
	     <IsPackable>true</IsPackable> and pick up doc-gen + warning-as-error on missing comments (CS1591).
	     In-solution libraries and apps set <IsPackable>false</IsPackable> and skip the ceremony;
	     executables (OutputType=Exe) are excluded outright. -->
	<PropertyGroup Condition="'$(IsTestProject)' != 'true' and '$(OutputType)' != 'Exe' and '$(IsPackable)' != 'false'">
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
	</PropertyGroup>

</Project>
